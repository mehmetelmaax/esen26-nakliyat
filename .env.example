# [ZORUNLU - CANLI SÜRÜM İÇİN] Resend API Kimliği (Teklif e-postası gönderimi için)
RESEND_API_KEY=

# [ZORUNLU - CANLI SÜRÜM İÇİN] Tekliflerin gönderileceği yönetici e-posta adresi
NOTIFY_EMAIL=

# [OPSİYONEL - VARSAYILAN: onboarding@resend.dev] Resend doğrulanmış gönderici e-postası
RESEND_FROM_EMAIL=

# [ZORUNLU] Google Analytics 4 Ölçüm Kimliği (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=

# [ZORUNLU] Google Search Console mülk doğrulama kodu
NEXT_PUBLIC_GSC_VERIFICATION=

# [OPSİYONEL] Canlı site URL'i (Vercel Preview canonical karmaşasını önlemek için)
NEXT_PUBLIC_SITE_URL=

# [OPSİYONEL] Microsoft Clarity Proje Kimliği (10 haneli)
NEXT_PUBLIC_CLARITY_ID=

# [OPSİYONEL] Yandex Webmaster doğrulama kodu
NEXT_PUBLIC_YANDEX_VERIFICATION=

# [OPSİYONEL] K3 Yetki Belgesi numarası (schema.org hasCredential alanına işlenir, E-E-A-T sinyali)
NEXT_PUBLIC_K3_BELGE_NO=

# [OPSİYONEL] Vercel KV REST API bağlantı URL'i (Upstash Redis REST tabanlı rate limit ve yedekleme için)
KV_REST_API_URL=

# [OPSİYONEL] Vercel KV REST API erişim token'ı
KV_REST_API_TOKEN=

# [OPSİYONEL] Google E-Tablolar (Google Sheets) entegrasyonu webhook URL'i
GOOGLE_SHEETS_WEBHOOK_URL=
